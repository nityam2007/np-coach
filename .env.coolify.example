# Paste these into Coolify's Environment Variables > Developer view.
# Leave secret values blank here; fill them only in Coolify. The SERVICE_* secrets
# referenced by docker-compose.coolify.yml are generated and retained by Coolify.

# Required before the first deployment
NEXT_PUBLIC_SITE_URL=https://np-coaches.co.uk
NEXT_PUBLIC_DIRECTUS_URL=https://cms.np-coaches.co.uk
DIRECTUS_ADMIN_EMAIL=admin@np-coaches.co.uk
DIRECTUS_ADMIN_PASSWORD=

# Required before forms, accounts, bookings, and webhooks go live.
# Create a dedicated API-only Directus user after the first deployment; do not use
# the generated Directus admin token here.
DIRECTUS_SERVER_TOKEN=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Microsoft 365 / Outlook SMTP
SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=npclostproperty@outlook.com
SMTP_PASS=
SMTP_FROM=npclostproperty@outlook.com
LOST_PROPERTY_TO=info@np-coaches.co.uk
