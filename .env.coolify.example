# Paste these into Coolify's Environment Variables > Developer view.
# Leave secret values blank here; fill them only in Coolify. Infrastructure SERVICE_*
# secrets are generated and retained by Coolify from the Compose file.

# Required before the first deployment
NEXT_PUBLIC_SITE_URL=https://np-coaches.co.uk
NEXT_PUBLIC_DIRECTUS_URL=https://cms.np-coaches.co.uk
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-3GXSRDBP55
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=PEWp9KTyvJeyPa_1TpAQO3fdLzljRv8RnNggD-h8gsg
DIRECTUS_ADMIN_EMAIL=admin@np-coaches.co.uk
DIRECTUS_ADMIN_PASSWORD=

# Safe defaults for the one-shot CMS bootstrap. These keep seed/configuration/media
# below Directus's API burst limit and retry temporary upstream failures.
DIRECTUS_BOOTSTRAP_REQUEST_INTERVAL_MS=50
DIRECTUS_BOOTSTRAP_MAX_RETRIES=10
DIRECTUS_BOOTSTRAP_REQUEST_TIMEOUT_MS=30000

# Required before forms, accounts, bookings, and webhooks go live.
# Create a dedicated API-only Directus user after the first deployment; do not use
# the generated Directus bootstrap admin token here.
DIRECTUS_SERVER_TOKEN=
# Application security (generate independent random values)
OTP_PEPPER=
RATE_LIMIT_PEPPER=
REVALIDATION_SECRET=
MAINTENANCE_SECRET=
TICKET_SIGNING_SECRET=
INTERNAL_API_SECRET=


# Cloudflare Turnstile — existing MAIN widget (Managed mode)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEIHn04_DdOECHBI
TURNSTILE_SECRET=
# Compatibility alias accepted by the app; prefer TURNSTILE_SECRET above.
TURNSTILE_SECRET_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep false until per-departure inventory and capacity controls have passed
# production acceptance. The server refuses Daily Express checkout while false.
DAILY_EXPRESS_BOOKINGS_ENABLED=false


# Host-side encrypted backup job (not passed to application containers)
BACKUP_AGE_RECIPIENT=
RCLONE_REMOTE=
RETENTION_DAYS=14
# Internal Postfix SMTP relay
SMTP_HOST=10.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH=false
SMTP_TLS=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@np-coaches.co.uk
SMTP_FROM_NAME=NP Coaches
CONTACT_TO=info@np-coaches.co.uk
QUOTE_TO=bookings@np-coaches.co.uk
LOST_PROPERTY_TO=info@np-coaches.co.uk
