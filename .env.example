# Copy to `.env` and fill in. Never commit `.env`.

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Browser-facing Directus URL (used by the client)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8055
# Optional locally. Production uses the public GA4 measurement ID and preserves
# the existing Search Console HTML verification token during the domain cutover.
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Server-to-server Directus URL. For host `npm run dev` use localhost; when the app
# runs INSIDE Docker, the `web` service overrides this to http://directus:8055
# (see docker-compose.yml), so leave this as localhost for the common host-dev setup.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_SERVER_TOKEN=
# Required in production. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Independent security values; use 32+ random bytes in production.
OTP_PEPPER=
RATE_LIMIT_PEPPER=
REVALIDATION_SECRET=
MAINTENANCE_SECRET=
TICKET_SIGNING_SECRET=
# Must match the Directus container; required for atomic OTP/payment/inventory operations.
INTERNAL_API_SECRET=dev-internal-secret-change-me-32
DAILY_EXPRESS_BOOKINGS_ENABLED=false
# Optional locally. Coolify injects the private Redis URL for shared app rate limits.
REDIS_URL=

# ---- Database (MariaDB — used only by Directus, never by the app) ----
DB_DATABASE=npcoaches
DB_USER=directus
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# ---- Directus ----
# Generate KEY/SECRET as random values, e.g. `openssl rand -hex 32`
DIRECTUS_KEY=replace-with-random-value
DIRECTUS_SECRET=replace-with-random-value
DIRECTUS_ADMIN_EMAIL=admin@np-coaches.co.uk
DIRECTUS_ADMIN_PASSWORD=change-me
# Optional static admin API token for automated bootstrap scripts. Coolify generates
# this separately; never reuse it as DIRECTUS_SERVER_TOKEN in the web app.
DIRECTUS_ADMIN_TOKEN=

# ---- Stripe (P4 Daily Express booking / P5) ----
# Daily Express uses Stripe Checkout (hosted). Point the Stripe webhook at
# /api/stripe/webhook and listen for checkout.session.completed.
# If STRIPE_SECRET_KEY is unset, the booking form shows a "being set up" notice.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Cloudflare Turnstile (Managed widget — server-side verification) ----
# The site key is public. Keep TURNSTILE_SECRET server-only and configure it in
# Coolify for production; local development may leave the secret blank.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEIHn04_DdOECHBI
TURNSTILE_SECRET=
# Compatibility alias accepted by the app; prefer TURNSTILE_SECRET above.
TURNSTILE_SECRET_KEY=

# ---- Internal Postfix SMTP relay (transactional email) ----
SMTP_HOST=10.0.0.1
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH=false
SMTP_TLS=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@np-coaches.co.uk
SMTP_FROM_NAME=NP Coaches
BOOKING_TO=bookings@np-coaches.co.uk
CONTACT_TO=info@np-coaches.co.uk
QUOTE_TO=bookings@np-coaches.co.uk
LOST_PROPERTY_TO=info@np-coaches.co.uk

# ---- Production deploy (docker-compose.prod.yml + Traefik) — see DEPLOY.md ----
# Copy this file to .env.prod on the VPS and fill in real values. The two hosts are the
# domains Traefik routes by (DNS A records, Cloudflare-proxied). NEXT_PUBLIC_* above must
# point at the public https URLs in production.
SITE_HOST=np-coaches.co.uk
# Optional review host that serves the same site and may access the Directus API.
# This is deliberately separate from SITE_HOST so canonical URLs remain unchanged.
DEMO_HOST=demo3000.nsheth.in
DIRECTUS_HOST=cms.np-coaches.co.uk
# Optional review hostname for the same Directus instance.
DEMO_DIRECTUS_HOST=demo8055.nsheth.in
