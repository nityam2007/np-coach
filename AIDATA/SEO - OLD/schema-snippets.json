/* ============================================================
   7. FAQPAGE
   PLACE ON: /faqs/ (and /home-to-school/ — adapt questions accordingly)
   Rewrite questions and answers to match real content on the page.
   Every answer kept to 40-60 words for AI extraction.
============================================================ */
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How far in advance should I book a coach with NP Coaches?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For charter and private hire, we recommend booking at least 24 hours in advance to confirm vehicle availability. For our Daily Express scheduled service, online bookings are accepted up to 1 hour before departure."
      }
    },
    {
      "@type": "Question",
      "name": "Are NP Coaches drivers DBS-checked?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Every NP Coaches driver holds a current Enhanced DBS check, particularly important for our home-to-school services to Pioneer Secondary Academy and Herschel Grammar School. Drivers also hold full UK PCV Category D licences."
      }
    },
    {
      "@type": "Question",
      "name": "What size coach do I need for my group?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our fleet covers 19, 35, 53, 72, 86, and 98 seats. As a guide: under 20 passengers use a mini coach (19 seat); 20 to 35 use a midi (35 seat); 36 to 53 use a standard executive (53 seat); 54+ use a 72 seater or double-decker."
      }
    },
    {
      "@type": "Question",
      "name": "Does NP Coaches operate ULEZ-compliant vehicles?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. The entire NP Coaches fleet is Euro 6 emissions standard and fully ULEZ-compliant, so there are no additional charges for journeys within London's Ultra Low Emission Zone."
      }
    },
    {
      "@type": "Question",
      "name": "Where does the Daily Express service pick up in London?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The Daily Express service picks up in Southall (West London) and in Slough at the Library (Stop W), opposite the Moxy Hotel, Wellington Street, SL1 1YG. From there it serves Coventry, Birmingham Soho Road, Birmingham Smethwick, Wolverhampton, and (Fri to Mon only) Leicester."
      }
    },
    {
      "@type": "Question",
      "name": "How much does coach hire cost in London?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Coach hire cost depends on vehicle size, journey distance, duration, and date. NP Coaches provides free, no-obligation quotes via the online quote form or by phone on +44 208 843 1000. Quotes are typically returned within one working day."
      }
    },
    {
      "@type": "Question",
      "name": "What luggage can I bring on the Daily Express coach?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Each passenger may bring 1 × 20kg suitcase in the luggage hold plus 1 × 7kg hand luggage on board, included in the ticket price. Please arrive 15 minutes before departure to allow time for luggage loading."
      }
    }
  ]
}


