{
  "name": "np-coaches",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:poll": "WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev --webpack -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "eslint .",
    "seed": "node scripts/seed-directus.mjs",
    "configure": "node scripts/configure-directus.mjs",
    "media": "node scripts/upload-media.mjs",
    "bootstrap": "npm run seed && npm run configure && npm run media",
    "crawl": "node scripts/crawl-live-images.mjs",
    "schema:snapshot": "sh scripts/schema.sh snapshot",
    "schema:apply": "sh scripts/schema.sh apply"
  },
  "dependencies": {
    "geist": "^1.3.1",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "motion": "^12.42.2",
    "next": "^16.0.0",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
